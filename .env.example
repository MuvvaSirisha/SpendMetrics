# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Copy this file to ".env" and fill in your real values.
#
# IMPORTANT:
#   - Never commit ".env" to Git. It contains real credentials.
#   - This file (.env.example) IS safe to commit — it has no real values.
#   - The app reads these variables using python-dotenv.
# ─────────────────────────────────────────────────────────────────────────────

# ── MySQL Configuration ───────────────────────────────────────────────────────
# Set USE_MYSQL=true to connect to MySQL. Set to false to use SQLite instead.
USE_MYSQL=false

# MySQL connection details — only needed when USE_MYSQL=true
DB_HOST=localhost
DB_PORT=3306
DB_NAME=spendsense
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password

# ── Application Configuration ─────────────────────────────────────────────────
# Path to the SQLite database file (used when USE_MYSQL=false)
SQLITE_DB_PATH=data/spendsense.db

# Maximum CSV file size in megabytes
MAX_CSV_SIZE_MB=10

# Maximum number of rows allowed in a single CSV upload
MAX_CSV_ROWS=10000
